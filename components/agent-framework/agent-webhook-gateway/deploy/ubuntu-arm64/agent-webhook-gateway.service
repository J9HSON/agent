[Unit]
Description=Pi Agent Webhook Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pi-hackason/components/agent-framework/agent-webhook-gateway
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/preflight-ubuntu-arm64.mjs
ExecStart=/usr/bin/env node --env-file=.env dist/cli.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=default.target
