# Copy this file to .env and replace only the deployment-specific placeholders.
# .env is ignored by Git; do not commit model credentials.

# Optional: external receiver for agent.reply.completed events. When omitted,
# the local Agent Console acknowledges the already-persisted reply itself.
# AGENT_WEBHOOK_REPLY_URL=http://127.0.0.1:9080/agent-replies

# Official read-only Rerun web viewer from the same DimOS Runtime.
AGENT_WEBHOOK_MAP_URL=http://127.0.0.1:9878/

# Required for a remote robot deployment: target the dimos-mcp-wrapper, not dimos-dog-mcp.
AGENT_WEBHOOK_MCP_URL=http://REMOTE_WRAPPER_HOST:9991/mcp

# product uses the Pi model-backed Agent. Stage 1 validation is deterministic
# and does not require a model/API balance.
AGENT_WEBHOOK_TOOL_PROFILE=product
AGENT_WEBHOOK_RUNTIME=pi

# product Pi Agent model. The default API key source is the macOS Keychain
# service agent-webhook-gateway-siliconflow. Set AGENT_WEBHOOK_MODEL_API_KEY
# only on hosts that do not use Keychain; never commit the value.
AGENT_WEBHOOK_MODEL_PROVIDER=siliconflow
AGENT_WEBHOOK_MODEL_ID=zai-org/GLM-5.2
AGENT_WEBHOOK_MODEL_BASE_URL=https://api.siliconflow.cn/v1
# AGENT_WEBHOOK_MODEL_API_KEY=

# Gateway listener. Keep 127.0.0.1 unless an explicit network boundary protects it.
AGENT_WEBHOOK_HOST=127.0.0.1
AGENT_WEBHOOK_PORT=8080

# Persistent gateway data. Relative paths are resolved from this directory.
AGENT_WEBHOOK_DATABASE_PATH=data/agent-webhook.sqlite
AGENT_WEBHOOK_SESSION_DIR=data/agent-session

# Pi Coding Agent configuration, including the user's existing model authentication.
AGENT_WEBHOOK_AGENT_DIR=C:/Users/YOUR_USER/.pi/agent
AGENT_WEBHOOK_AGENT_CWD=.

# Optional timeouts and retry policy.
AGENT_WEBHOOK_MCP_TIMEOUT_MS=120000
AGENT_WEBHOOK_TASK_POLL_INTERVAL_MS=500
AGENT_WEBHOOK_TASK_TIMEOUT_MS=330000
AGENT_WEBHOOK_REPLY_TIMEOUT_MS=10000
AGENT_WEBHOOK_RETRY_BASE_MS=1000
AGENT_WEBHOOK_RETRY_MAX_MS=60000
AGENT_WEBHOOK_DEFAULT_SPEED_MPS=0.1
