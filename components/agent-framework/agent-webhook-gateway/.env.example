# Copy this file to .env and replace only the deployment-specific placeholders.
# .env is ignored by Git; do not commit model credentials.

# Required for a remote robot deployment: target the dimos-mcp-wrapper, not dimos-dog-mcp.
AGENT_WEBHOOK_MCP_URL=http://REMOTE_WRAPPER_HOST:9991/mcp

# Optional: when set, the Agent receives a separate speak(text) tool for user-facing TTS.
# AGENT_WEBHOOK_TTS_MCP_URL=http://TTS_DEVICE_HOST:9992/mcp
# AGENT_WEBHOOK_TTS_MCP_TIMEOUT_MS=10000

# Gateway listener. Keep 127.0.0.1 unless an explicit network boundary protects it.
AGENT_WEBHOOK_HOST=127.0.0.1
AGENT_WEBHOOK_PORT=8080

# Persistent gateway data. Relative paths are resolved from this directory.
AGENT_WEBHOOK_DATABASE_PATH=data/agent-webhook.sqlite
AGENT_WEBHOOK_SESSION_DIR=data/agent-session

# Pi Coding Agent configuration, including the user's existing model authentication.
# AGENT_WEBHOOK_AGENT_DIR defaults to ~/.pi/agent on both Windows and Linux.
AGENT_WEBHOOK_AGENT_CWD=.

# Optional robot MCP timeout and movement planning calibration.
AGENT_WEBHOOK_MCP_TIMEOUT_MS=120000
AGENT_WEBHOOK_DEFAULT_SPEED_MPS=0.1

# Health is disabled unless both required values below are set.
# Connect to the Health MCP running on the smart-collar host; the Gateway does not spawn it locally.
# The hackathon Health MCP and webhook paths intentionally have no authentication.
# AGENT_WEBHOOK_HEALTH_WEARER_ID=wearer-001
# AGENT_WEBHOOK_HEALTH_MCP_URL=http://HEALTH_HOST:8765/mcp
# AGENT_WEBHOOK_HEALTH_MCP_TIMEOUT_MS=10000
# AGENT_WEBHOOK_HEALTH_RETRY_BASE_MS=1000
# AGENT_WEBHOOK_HEALTH_RETRY_MAX_MS=60000
