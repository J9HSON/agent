# 此示例可复制到 WSL 的 ~/.config/dimos-dog-mcp/go2.env。
# 不要把实际密钥写入仓库或提交到 Git。
ROBOT_IP=192.168.12.1
# 仅 data2=3 的较新固件需要；data2=2 的旧握手不要填写。
# UNITREE_AES_128_KEY=replace-with-your-aes-key
DIMOS_DOG_MCP_MODE=go2
DIMOS_DOG_MCP_HOST=127.0.0.1
DIMOS_DOG_MCP_PORT=9990
DIMOS_DOG_MCP_TOOL_PROFILE=product
# 官方 PersonFollowSkillContainer 的初次人物识别使用以下 Qwen VL 配置。
DIMOS_QWEN_VL_BASE_URL=https://api.siliconflow.cn/v1
DIMOS_QWEN_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 私钥只能写入 WSL 私有 go2.env，不能写入仓库：
# DIMOS_QWEN_VL_API_KEY=replace-with-your-siliconflow-key
DIMOS_SEMANTIC_WORLD_PATH=~/.dimos/go2-studio/semantic-world.json
DIMOS_MAP_ID=venue-test
DIMOS_MAP_VERSION=map-v1
DIMOS_PREMAP_FILE=~/.dimos/go2-studio/venue-test.pc2.lcm
# 保留官方默认 50000；只有离线 replay 已证明当前传感器点数足够时才显式调整。
# DIMOS_RELOCALIZATION_MIN_LOCAL_POINTS=35000
VIEWER=rerun
RERUN_OPEN=native
